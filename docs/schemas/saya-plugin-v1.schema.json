{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:saya:plugin-manifest:v1",
  "title": "Saya plugin manifest v1 draft",
  "description": "Draft manifest structure. Runtime semantic, path, compatibility and permission validation is also required.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plugin",
    "compatibility",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "description",
        "license"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/pluginId"
        },
        "version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "license_file": {
          "$ref": "#/$defs/relativePath"
        },
        "homepage": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires_saya",
        "requires_features"
      ],
      "properties": {
        "requires_saya": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "requires_features": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "contains": {
            "const": "plugin-manifest-v1"
          },
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*-v[1-9][0-9]*$"
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested"
      ],
      "properties": {
        "requested": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "enum": [
              "workspace.read",
              "workspace.write",
              "process.exec",
              "network.outbound",
              "credential.use",
              "mcp.stdio",
              "mcp.http",
              "hook.observe",
              "hook.check",
              "browser.observe",
              "browser.interact",
              "artifact.read",
              "artifact.write"
            ]
          }
        },
        "network_origins": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https://",
            "format": "uri",
            "maxLength": 2048
          }
        },
        "credential_slots": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/entryId"
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/entryId"
          },
          "path": {
            "$ref": "#/$defs/relativePath"
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "media_type"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/entryId"
          },
          "path": {
            "$ref": "#/$defs/relativePath"
          },
          "media_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "mcp": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/mcpStdio"
          },
          {
            "$ref": "#/$defs/mcpHttp"
          }
        ]
      }
    },
    "hooks": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "event",
          "kind",
          "program",
          "args",
          "timeout_ms"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/entryId"
          },
          "event": {
            "enum": [
              "run.started",
              "run.finished",
              "tool.before_dispatch",
              "tool.finished"
            ]
          },
          "kind": {
            "enum": [
              "observer",
              "check"
            ]
          },
          "program": {
            "$ref": "#/$defs/program"
          },
          "args": {
            "$ref": "#/$defs/args"
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "check"
                }
              }
            },
            "then": {
              "properties": {
                "event": {
                  "const": "tool.before_dispatch"
                }
              }
            }
          }
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/pluginId"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "skills"
      ],
      "properties": {
        "skills": {
          "minItems": 1
        }
      }
    },
    {
      "required": [
        "resources"
      ],
      "properties": {
        "resources": {
          "minItems": 1
        }
      }
    },
    {
      "required": [
        "mcp"
      ],
      "properties": {
        "mcp": {
          "minItems": 1
        }
      }
    },
    {
      "required": [
        "hooks"
      ],
      "properties": {
        "hooks": {
          "minItems": 1
        }
      }
    }
  ],
  "$defs": {
    "pluginId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$"
    },
    "entryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)[^\\u0000-\\u001f\\u007f]+$"
    },
    "program": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "args": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "maxLength": 8192,
        "pattern": "^[^\\u0000]*$"
      }
    },
    "mcpStdio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "transport",
        "program",
        "args"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/entryId"
        },
        "transport": {
          "const": "stdio"
        },
        "program": {
          "$ref": "#/$defs/program"
        },
        "args": {
          "$ref": "#/$defs/args"
        },
        "credential_slots": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/entryId"
          }
        }
      }
    },
    "mcpHttp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "transport",
        "url"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/entryId"
        },
        "transport": {
          "const": "streamable-http"
        },
        "url": {
          "type": "string",
          "pattern": "^https://",
          "format": "uri",
          "maxLength": 2048
        },
        "credential_slots": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/entryId"
          }
        }
      }
    }
  }
}
